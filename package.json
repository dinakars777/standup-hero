{
  "name": "@dinakars777/standup-hero",
  "version": "1.0.0",
  "description": "🦸‍♂️ Fast CLI tool to generate beautiful markdown daily standups from local Git history.",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist"
  ],
  "bin": {
    "standup-hero": "dist/index.js",
    "standup": "dist/index.js"
  },
  "scripts": {
    "build": "tsup src/index.ts --format cjs --clean",
    "dev": "ts-node src/index.ts",
    "start": "node dist/index.js",
    "test": "node --test test/*.test.cjs"
  },
  "keywords": [
    "cli",
    "standup",
    "git",
    "history",
    "markdown",
    "auto",
    "clipboard"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@clack/prompts": "^1.1.0",
    "clipboardy": "^5.3.1",
    "commander": "^14.0.3",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^25.3.3",
    "ts-node": "^10.9.2",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
